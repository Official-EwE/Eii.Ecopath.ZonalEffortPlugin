<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>.net48;net10.0</TargetFrameworks>
    <!--<Nullable>enable</Nullable>-->
    <OutputType>Library</OutputType>
    <SignAssembly>True</SignAssembly>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <!--<AssemblyOriginatorKeyFile>TemplateRepoWindowsEii.snk</AssemblyOriginatorKeyFile>-->
    <PackageId>TemplateRepoWindowsEii</PackageId>
    <Authors>EII</Authors>
    <Description>Description of the package</Description>
    <Title>TemplateRepoWindowsEii</Title>
    <PackageProjectUrl>https://github.com/Official-EwE/TemplateRepoWindowsEii</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Official-EwE/TemplateRepoWindowsEii</RepositoryUrl>
    <PackageReleaseNotes>Initial version</PackageReleaseNotes>
    <PackageLicenseExpression>EUPL-1.2-or-later</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <IncludeSymbols>True</IncludeSymbols>
    <Company>EII</Company>
    <PackageIcon>EII_plain_128x128.png</PackageIcon>
    <RootNamespace>TemplateRepoWindowsEii</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\EII_plain_128x128.png" Pack="True" PackagePath="\" />
  </ItemGroup>
</Project>
